# Únicamente necesario si se consume también desde un navegador web.
# Flutter móvil (Android/iOS) no necesita CORS.
CORS_ORIGINS=

# Protecciones HTTP del PMV2
MAX_REQUEST_BODY_BYTES=16384
RATE_LIMIT_PER_MINUTE=120

# Timeouts de servicios geográficos externos (segundos)
PNP_TIMEOUT_SECONDS=5
OSINERGMIN_TIMEOUT_SECONDS=5

# Catálogo territorial centralizado en el backend principal DenuPe (PostgreSQL en Render).
DENUPE_BACKEND_BASE_URL=https://denupe-backend.onrender.com
DENUPE_BACKEND_TIMEOUT_SECONDS=12
